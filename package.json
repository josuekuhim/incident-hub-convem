{
  "name": "incident-hub-convem",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @incident-hub/api",
    "dev:web": "npm run dev --workspace @incident-hub/web",
    "seed": "npm run seed --workspace @incident-hub/api",
    "test": "npm run test --workspace @incident-hub/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @incident-hub/api",
    "build:web": "npm run build --workspace @incident-hub/web"
  }
}
